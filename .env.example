# Required for app persistence and email/password sessions. Never commit .env files.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/leadatlas?sslmode=require
DIRECT_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
# Comma-separated Better Auth user ids. Set only after creating your admin account.
ADMIN_USER_IDS=
# Transactional authentication email (operator managed; verified sender required).
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Set true only after verifying the sender domain in Resend.
AUTH_EMAIL_SENDER_VERIFIED=false
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set to 1 only for local Inngest development (never production).
INNGEST_DEV=0
WORKER_URL=http://localhost:4000
# Random shared secret >=32 characters, identical on web and worker.
WORKER_SECRET=
PORT=4000
BRAVE_SEARCH_API_KEY=
HUNTER_API_KEY=
HUNTER_REUSE_APPROVED=false
ZEROBOUNCE_API_KEY=
GOOGLE_PLACES_API_KEY=
# Explicit Google display/use review required; Google never enters lead storage.
GOOGLE_DISPLAY_APPROVED=false
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=
META_INSTAGRAM_ACCOUNT_ID=
META_APPROVAL_CONFIRMED=false
# Meta remains restricted for lead exports, even with a token.
AZURE_MAPS_SUBSCRIPTION_KEY=
FOURSQUARE_API_KEY=
MAX_SEARCH_RESULTS=50
DAILY_SEARCH_BUDGET=500
PROVIDER_DAILY_LIMIT=500
INGEST_BATCH_LIMIT=500
EMAIL_FRESH_DAYS=30
SITE_FRESH_DAYS=30
ACTIVITY_FRESH_DAYS=90
# Global domain discovery: keys alone do not confirm permitted use. Review terms.
BRAVE_DISCOVERY_APPROVED=false
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_DISCOVERY_APPROVED=false
# Required multi-country SERP locale codes; no built-in US/New York default.
DATAFORSEO_LOCATION_CODES=
COMMONCRAWL_DISCOVERY_APPROVED=false
# Pin a current archive ID after review, e.g. CC-MAIN-YYYY-WW.
COMMONCRAWL_INDEX=
# Optional evidence explanation only; disabled and never required for searches.
RESEARCH_AI_ENABLED=false
RESEARCH_AI_BASE_URL=
RESEARCH_AI_MODEL=
RESEARCH_AI_API_KEY=
SEARCH_INITIAL_RESULTS=10
SEARCH_QUERY_BUDGET=20
# Optional homepage subscription. No updates sent before explicit email confirmation.
UPDATES_EMAIL_FROM=
UPDATES_SENDER_VERIFIED=false
# Separate random server-only key (32+ characters); retain for old unsubscribe links.
UPDATES_TOKEN_SECRET=
# Enable only behind an edge that strips/sets trusted client IP headers.
UPDATES_TRUST_PROXY=false
