{
  "name": "leadatlas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "worker": "tsx src/worker/server.ts",
    "ingest": "tsx scripts/import.ts",
    "cleanup": "tsx scripts/cleanup.ts",
    "format": "prettier --write src scripts tests docs README.md *.ts *.mjs *.json .github/workflows/ci.yml"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "better-auth": "1.7.14",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.0.0",
    "drizzle-orm": "0.45.4",
    "inngest": "4.26.2",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "1.65.0",
    "motion": "14.8.0",
    "next": "16.4.3",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "robots-parser": "^3.0.1",
    "tailwind-merge": "^3.3.0",
    "tldts": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.5",
    "prettier": "^3.6.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "@opentelemetry/api": "1.9.1",
    "zod": "$zod"
  }
}
